discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "filename"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "filename"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    target_label = "job"
    replacement  = "varlogs"
  }

  rule {
    source_labels = ["container"]
    regex         = "system-monitoring-(loki|alloy)"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.filter.receiver]   // changed: go through the processor
}

loki.process "filter" {
  stage.multiline {
    firstline     = "^\\S"
    max_wait_time = "3s"
    max_lines     = 500
  }

  // Don't send backlog older than Loki accepts (avoids the 400 errors)
  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "too_old"
  }

  stage.drop {
    expression          = ".*msg=\"Plugin Request Completed\".*"
    drop_counter_reason = "grafana_plugin_requests"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
