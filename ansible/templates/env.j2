# Gateway & Monitoring Config
ADMIN_NAME={{ vault_admin_name }}
ADMIN_KEY={{ vault_admin_key }}
VIEWER_NAME={{ vault_viewer_name }}
VIEWER_KEY={{ vault_viewer_key }}

# Database Config
DB_PORT={{ vault_db_port }}
DB_USER={{ vault_db_user }}
DB_NAME={{ vault_db_name }}
DB_PASSWORD={{ vault_db_password }}

# Hoppscotch Config
#-----------------------Backend Config------------------------------#
# Prisma Config
DATABASE_URL="postgresql://{{ vault_db_user }}:{{ vault_db_password }}@{{ vault_db_host | default('localhost') }}:{{ vault_db_port | default(5432) }}/{{ vault_db_name }}?schema=public"

# Sensitive Data Encryption Key while storing in Database (Must be exactly 32 characters)
DATA_ENCRYPTION_KEY={{ vault_hoppscotch_encryption_key }}

WHITELISTED_ORIGINS={{ vault_hoppscotch_whitelisted_origins }}

PROXY_APP_URL="{{ vault_hoppscotch_proxy_app_url }}"
PROXYSCOTCH_ALLOWED_ORIGINS={{ vault_hoppscotch_proxyscotch_allowed_origins }}

# If true, the client’s IP address is understood as the left-most entry in the X-Forwarded-For header
TRUST_PROXY=true

#-----------------------Frontend Config------------------------------#

# Base URLs
VITE_BASE_URL={{ vault_hoppscotch_base_url }}
VITE_SHORTCODE_BASE_URL={{ vault_hoppscotch_shortcode_url | default(vault_hoppscotch_base_url) }}
VITE_ADMIN_URL={{ vault_hoppscotch_admin_url }}

# Backend URLs
VITE_BACKEND_GQL_URL={{ vault_hoppscotch_backend_url }}/graphql
VITE_BACKEND_WS_URL={{ vault_hoppscotch_backend_ws_url }}
VITE_BACKEND_API_URL={{ vault_hoppscotch_backend_url }}/v1

VITE_ALLOWED_AUTH_PROVIDERS={{ hoppscotch_auth_providers | default('GOOGLE') }}
GOOGLE_CLIENT_ID={{ vault_google_client_id }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret }}
GOOGLE_CALLBACK_URL={{ vault_hoppscotch_backend_url }}/v1/auth/google/callback

# Terms Of Service And Privacy Policy Links (Optional)
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy

# Set default to null as https://proxy.hoppscotch.io/ doesn't require an access token
VITE_PROXYSCOTCH_ACCESS_TOKEN=

# Set to `true` for subpath based access
ENABLE_SUBPATH_BASED_ACCESS={{ vault_hoppscotch_subpath_access | default('false') }}
